# ==========================================
# SAKHI ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Database Configuration (PostgreSQL + PostGIS)
# In production, use your PostGIS credentials.
# In local development without Postgres, leave blank to use SQLite fallback.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sakhi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sakhi_db

# Redis Configuration (Real-time tracking, SOS state, presence)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography
JWT_SECRET=sakhi-super-secure-privacy-first-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Machine Learning
ML_MODEL_PATH=ml/models/sakhi_risk_model.joblib

# Firebase Cloud Messaging (Optional production credentials)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Maps SDK Key (Optional, OpenStreetMap fallback available)
GOOGLE_MAPS_API_KEY=

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
